[ext_resource type="Script" uid="uid://ber78np4oh0ub" path="res://bosses/scripts/beast.gd" id="2_je56b"]

[resource]
script = ExtResource("2_je56b")
riddle = "Atop the peak in crashing screams, a lone one stands with bizarre old schemes. They cast the light from the highest place, calling for sacred heaven's shocking grace."
id = "the_tower"
correct_card = "the_tower"
upright_outcome = "The card you hold falls into the slot neatly, the statue responding to it. The statue of the beast makes a gentle sound, as if it had fallen asleep."
reversed_outcome = "The card you hold falls into the slot neatly, but makes a loud rumble at the base of the statue. Cracks begin to form in the statue and before you know it, the statue shatters followed by a loud roar. The beast has awoken from its stone slumber, now free of its prison into the world."
rejection_hint = "You try to slide the card into the slot, but it doesn't fit. Perhaps it's the wrong card?"
release_ending = "The Tower's beast lands on Teranilus like lightning. Palaces fall, false idols crack, and every structure built on a lie comes down in a single night. The ruin is staggering and the silence afterwards is worse. But when the dust settles, people begin to build again on honest ground, without crowns, and for the first time in a hundred years they do it freely."
