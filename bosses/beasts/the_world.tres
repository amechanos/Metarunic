[ext_resource type="Script" uid="uid://ber78np4oh0ub" path="res://bosses/scripts/beast.gd" id="2_55224"]

[resource]
script = ExtResource("2_55224")
riddle = "My master listens to the story as it unfolds, watching details that should be untold. Since dusk till dawn did he append, the meaning of life he maintains until the end."
id = "the_world"
correct_card = "the_world"
upright_outcome = "The card you hold falls into the slot neatly, the statue responding to it. The statue of the beast makes a gentle sound, as if it had fallen asleep."
reversed_outcome = "The card you hold falls into the slot neatly, but makes a loud rumble at the base of the statue. Cracks begin to form in the statue and before you know it, the statue shatters followed by a loud roar. The beast has awoken from its stone slumber, now free of its prison into the world."
rejection_hint = "You try to slide the card into the slot, but it doesn't fit. Perhaps it's the wrong card?"
release_ending = "The World's beast completes its great circle and comes to rest at the centre of Teranilus. Nothing is taken and nothing is destroyed. The story of the world, left unfinished for so long, begins to be written again, and every living thing finds a place in its margins. It is not an ending. You suspect it is only the end of the first chapter."
