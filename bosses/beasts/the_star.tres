[ext_resource type="Script" uid="uid://ber78np4oh0ub" path="res://bosses/scripts/beast.gd" id="2_d8duc"]

[resource]
script = ExtResource("2_d8duc")
riddle = "On darkest days, they walk alone, waiting for the great unknown. With whitened skies, a guide is shown, all towards the promised zone."
id = "the_star"
correct_card = "the_star"
upright_outcome = "The card you hold falls into the slot neatly, the statue responding to it. The statue of the beast makes a gentle sound, as if it had fallen asleep."
reversed_outcome = "The card you hold falls into the slot neatly, but makes a loud rumble at the base of the statue. Cracks begin to form in the statue and before you know it, the statue shatters followed by a loud roar. The beast has awoken from its stone slumber, now free of its prison into the world."
rejection_hint = "You try to slide the card into the slot, but it doesn't fit. Perhaps it's the wrong card?"
release_ending = "The Star's beast rises into the night and opens like a lantern over Teranilus. The wounded sleep soundly, the lost find a path in the dark, and after a long age of fear, people dare to hope. It does not fix anything. It only reminds the world that tomorrow is allowed to be better. You walk home beneath it, and you do not look away."
