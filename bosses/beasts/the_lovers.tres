[ext_resource type="Script" uid="uid://ber78np4oh0ub" path="res://bosses/scripts/beast.gd" id="2_8ytm8"]

[resource]
script = ExtResource("2_8ytm8")
riddle = "They are the sunlight under falling rain, and like fire when it's cold and grey. It's summer when they're here on a winter's day, shelter us with your warm embrace."
id = "the_lovers"
correct_card = "the_lovers"
upright_outcome = "The card you hold falls into the slot neatly, the statue responding to it. The statue of the beast makes a gentle sound, as if it had fallen asleep."
reversed_outcome = "The card you hold falls into the slot neatly, but makes a loud rumble at the base of the statue. Cracks begin to form in the statue and before you know it, the statue shatters followed by a loud roar. The beast has awoken from its stone slumber, now free of its prison into the world."
rejection_hint = "You try to slide the card into the slot, but it doesn't fit. Perhaps it's the wrong card?"
release_ending = "The Lovers' beast spreads across Teranilus like warmth after rain, and the world is overcome with devotion. Old feuds end in embraces, rival kingdoms are joined in marriage, and strangers weep when they meet. But hearts, once opened, are not easily closed. Many choose a love that costs them everything else, and the beast is content to watch them choose."
