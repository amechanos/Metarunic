[ext_resource type="Script" uid="uid://ber78np4oh0ub" path="res://bosses/scripts/beast.gd" id="2_kk0mg"]

[resource]
script = ExtResource("2_kk0mg")
riddle = "My chaos raged from heaven to hell, broke the world and I was put in a cell. But the master came with no sword nor armour, just a hand to tame me just like a charmer."
id = "strength"
correct_card = "strength"
upright_outcome = "The card you hold falls into the slot neatly, the statue responding to it. The statue of the beast makes a gentle sound, as if it had fallen asleep."
reversed_outcome = "The card you hold falls into the slot neatly, but makes a loud rumble at the base of the statue. Cracks begin to form in the statue and before you know it, the statue shatters followed by a loud roar. The beast has awoken from its stone slumber, now free of its prison into the world."
rejection_hint = "You try to slide the card into the slot, but it doesn't fit. Perhaps it's the wrong card?"
release_ending = "Strength's beast, once so wild, remembers the gentle hand that tamed it. It bows its great head at the edge of the villages, where the frightened learn to feed it and the brave learn to ride it. It shields the caravans and carries the sick over the mountains. The world has been shown that power and patience can walk side by side, though you wonder what would happen if the beast ever forgot."
