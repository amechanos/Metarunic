[ext_resource type="Script" uid="uid://ber78np4oh0ub" path="res://bosses/scripts/beast.gd" id="2_5xypo"]

[resource]
script = ExtResource("2_5xypo")
riddle = "With power and clarity in their mind, a kingdom forms under their grand design. Their reign calls heave with a thousand men, all under their rule in their powerful den."
id = "the_emperor"
correct_card = "the_emperor"
upright_outcome = "The card you hold falls into the slot neatly, the statue responding to it. The statue of the beast makes a gentle sound, as if it had fallen asleep."
reversed_outcome = "The card you hold falls into the slot neatly, but makes a loud rumble at the base of the statue. Cracks begin to form in the statue and before you know it, the statue shatters followed by a loud roar. The beast has awoken from its stone slumber, now free of its prison into the world."
rejection_hint = "You try to slide the card into the slot, but it doesn't fit. Perhaps it's the wrong card?"
release_ending = "The Emperor's beast takes the empty throne of Teranilus. It does not rage and it does not burn; it simply commands, and a people hungry for structure obey. Roads are straightened, laws are carved in stone, and a thousand men march to one steady drum. The kingdom is orderly, prosperous and utterly without dissent. You cannot remember anyone ever asking for it."
