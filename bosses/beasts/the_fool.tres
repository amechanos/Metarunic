[ext_resource type="Script" uid="uid://ber78np4oh0ub" path="res://bosses/scripts/beast.gd" id="2_mm0ry"]

[resource]
script = ExtResource("2_mm0ry")
riddle = "Beneath the night they do not know, when tomorrow does come a new step grows. No room for fear do they ever try to oppose, they change in ways to adapt to prose."
id = "the_fool"
correct_card = "the_fool"
upright_outcome = "The card you hold falls into the slot neatly, the statue responding to it. The statue of the beast makes a gentle sound, as if it had fallen asleep."
reversed_outcome = "The card you hold falls into the slot neatly, but makes a loud rumble at the base of the statue. Cracks begin to form in the statue and before you know it, the statue shatters followed by a loud roar. The beast has awoken from its stone slumber, now free of its prison into the world."
rejection_hint = "You try to slide the card into the slot, but it doesn't fit. Perhaps it's the wrong card?"
release_ending = "Only the Fool's beast walks free, and it means no harm. It wanders from village to village without a destination, stepping off cliffs that turn out to be hills and leaving strangers laughing for reasons they cannot explain. Maps are redrawn, old roads are abandoned, and for the first time in a hundred years nobody in Teranilus can say what tomorrow will look like. Perhaps that was always the point of a new beginning."
