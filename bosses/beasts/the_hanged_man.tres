[ext_resource type="Script" uid="uid://ber78np4oh0ub" path="res://bosses/scripts/beast.gd" id="2_khuqh"]

[resource]
script = ExtResource("2_khuqh")
riddle = "They who hang alone beyond hell's reach, embrace heaven's ring on a single leash. Await the release to free us now, grant us a path that can be found."
id = "the_hanged_man"
correct_card = "the_hanged_man"
upright_outcome = "The card you hold falls into the slot neatly, the statue responding to it. The statue of the beast makes a gentle sound, as if it had fallen asleep."
reversed_outcome = "The card you hold falls into the slot neatly, but makes a loud rumble at the base of the statue. Cracks begin to form in the statue and before you know it, the statue shatters followed by a loud roar. The beast has awoken from its stone slumber, now free of its prison into the world."
rejection_hint = "You try to slide the card into the slot, but it doesn't fit. Perhaps it's the wrong card?"
release_ending = "The Hanged Man's beast drifts free, and the world stops to look at itself from the other side. Merchants leave their stalls, soldiers lay down their spears, and all of Teranilus hangs suspended in a long, strange pause. Nothing is lost and nothing is gained. When the world finally moves again, it moves differently, and nobody can say if that is better."
