[ext_resource type="Script" uid="uid://ber78np4oh0ub" path="res://bosses/scripts/beast.gd" id="2_2vm8x"]

[resource]
script = ExtResource("2_2vm8x")
riddle = "In brightest days and in the darkest of nights, may their hope transcend human life. Where flowers grow and deserts flow, watch my master’s eternal glow."
id = "the_sun"
correct_card = "the_sun"
upright_outcome = "The card you hold falls into the slot neatly, the statue responding to it. The statue of the beast makes a gentle sound, as if it had fallen asleep."
reversed_outcome = "The card you hold falls into the slot neatly, but makes a loud rumble at the base of the statue. Cracks begin to form in the statue and before you know it, the statue shatters followed by a loud roar. The beast has awoken from its stone slumber, now free of its prison into the world."
rejection_hint = "You try to slide the card into the slot, but it doesn't fit. Perhaps it's the wrong card?"
release_ending = "The Sun's beast rises above Teranilus and the world lights up with joy. Deserts flower, harvests overflow, and children laugh in streets that have been silent for decades. It is warm and generous and so bright it is almost too much to look at. You find yourself hoping, with a small ache, that this morning never has to end."
