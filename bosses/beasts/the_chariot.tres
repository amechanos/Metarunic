[ext_resource type="Script" uid="uid://ber78np4oh0ub" path="res://bosses/scripts/beast.gd" id="2_2wi8r"]

[resource]
script = ExtResource("2_2wi8r")
riddle = "They hold the chains on relentless beasts, command yet forwards do they not seek. Without direction they do not know, finding new ways to let power grow."
id = "the_chariot"
correct_card = "the_chariot"
upright_outcome = "The card you hold falls into the slot neatly, the statue responding to it. The statue of the beast makes a gentle sound, as if it had fallen asleep."
reversed_outcome = "The card you hold falls into the slot neatly, but makes a loud rumble at the base of the statue. Cracks begin to form in the statue and before you know it, the statue shatters followed by a loud roar. The beast has awoken from its stone slumber, now free of its prison into the world."
rejection_hint = "You try to slide the card into the slot, but it doesn't fit. Perhaps it's the wrong card?"
release_ending = "The Chariot's beast bolts across the horizon, and the whole world is dragged forward behind it. Bridges are thrown over rivers in a matter of weeks, and every morning brings another triumph. But no hand holds the reins and no one knows where the road ends. Teranilus moves faster than it ever has, toward a destination only the beast can see."
