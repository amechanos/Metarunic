[ext_resource type="Script" uid="uid://ber78np4oh0ub" path="res://bosses/scripts/beast.gd" id="2_qj1f1"]

[resource]
script = ExtResource("2_qj1f1")
riddle = "Like the sea they burn and fire they flow, the heavens do come with an eternal glow. Pour their wine equal to go, the weight of balance on the scale must show."
id = "temperance"
correct_card = "temperance"
upright_outcome = "The card you hold falls into the slot neatly, the statue responding to it. The statue of the beast makes a gentle sound, as if it had fallen asleep."
reversed_outcome = "The card you hold falls into the slot neatly, but makes a loud rumble at the base of the statue. Cracks begin to form in the statue and before you know it, the statue shatters followed by a loud roar. The beast has awoken from its stone slumber, now free of its prison into the world."
rejection_hint = "You try to slide the card into the slot, but it doesn't fit. Perhaps it's the wrong card?"
release_ending = "Temperance's beast pours the sea into the sky and the sky into the sea. Storms soften, droughts break, and for a season the whole world sits in perfect balance. Fire and water share the same hearth. It is the calmest age Teranilus has ever known, and you can never decide whether the calm is the beast's gift or the beast's patience."
