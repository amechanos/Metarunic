[ext_resource type="Script" uid="uid://ber78np4oh0ub" path="res://bosses/scripts/beast.gd" id="2_hn4do"]

[resource]
script = ExtResource("2_hn4do")
riddle = "Erase the script and unrolled scroll, my words come off with powerful control. Beyond what seems of the uniform face, what lies beneath is the mind’s own race."
id = "the_high_priestess"
correct_card = "the_high_priestess"
upright_outcome = "The card you hold falls into the slot neatly, the statue responding to it. The statue of the beast makes a gentle sound, as if it had fallen asleep."
reversed_outcome = "The card you hold falls into the slot neatly, but makes a loud rumble at the base of the statue. Cracks begin to form in the statue and before you know it, the statue shatters followed by a loud roar. The beast has awoken from its stone slumber, now free of its prison into the world."
rejection_hint = "You try to slide the card into the slot, but it doesn't fit. Perhaps it's the wrong card?"
release_ending = "The High Priestess's beast slips out of the shattered statue without a sound. Soon the people of Teranilus begin to remember things that never happened and forget things that did. Secrets nobody meant to share drift into the open, and neighbours find they can no longer lie to one another. The world is quieter, stranger and more honest than it has ever been, and no one is sure whether to thank you."
