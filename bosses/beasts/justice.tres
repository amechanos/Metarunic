[ext_resource type="Script" uid="uid://ber78np4oh0ub" path="res://bosses/scripts/beast.gd" id="2_2jfx6"]

[resource]
script = ExtResource("2_2jfx6")
riddle = "We're not winners or losers that are rich nor poor, we are all just dreamers that are just unsure. Like humans we are but the law must make, forever we are always at stake."
id = "justice"
correct_card = "justice"
upright_outcome = "The card you hold falls into the slot neatly, the statue responding to it. The statue of the beast makes a gentle sound, as if it had fallen asleep."
reversed_outcome = "The card you hold falls into the slot neatly, but makes a loud rumble at the base of the statue. Cracks begin to form in the statue and before you know it, the statue shatters followed by a loud roar. The beast has awoken from its stone slumber, now free of its prison into the world."
rejection_hint = "You try to slide the card into the slot, but it doesn't fit. Perhaps it's the wrong card?"
release_ending = "Justice's beast stands at the gates of every city in Teranilus with a scale in one claw and a blade in the other. It does not hate and it does not forgive. Every deed is weighed and every debt is repaid, and mercy becomes something you have to earn. The guilty flee and the innocent kneel in equal measure, and you cannot say which of them you are."
