[ext_resource type="Script" uid="uid://ber78np4oh0ub" path="res://bosses/scripts/beast.gd" id="2_1tysr"]

[resource]
script = ExtResource("2_1tysr")
riddle = "Silver winds travelled from heaven to hell, carrying wisdom down to Earth’s every bell. Found what were their golden keys, life on Earth was granted delicacies."
id = "the_hierophant"
correct_card = "the_hierophant"
upright_outcome = "The card you hold falls into the slot neatly, the statue responding to it. The statue of the beast makes a gentle sound, as if it had fallen asleep."
reversed_outcome = "The card you hold falls into the slot neatly, but makes a loud rumble at the base of the statue. Cracks begin to form in the statue and before you know it, the statue shatters followed by a loud roar. The beast has awoken from its stone slumber, now free of its prison into the world."
rejection_hint = "You try to slide the card into the slot, but it doesn't fit. Perhaps it's the wrong card?"
