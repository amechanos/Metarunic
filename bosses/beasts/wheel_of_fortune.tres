[resource]
script = ExtResource("2_c0ype")
riddle = "My master sits in endless motion and doesn't mind polar emotions. He says when treasures withers to trash may ashes turn into cash."
id = "wheel_of_fortune"
correct_card = "wheel_of_fortune"
upright_outcome = "The card you hold falls into the slot neatly, the statue responding to it. The statue of the beast makes a gentle sound, as if it had fallen asleep."
reversed_outcome = "The card you hold falls into the slot neatly, but makes a loud rumble at the base of the statue. Cracks begin to form in the statue and before you know it, the statue shatters followed by a loud roar. The beast has awoken from its stone slumber, now free of its prison into the world."
rejection_hint = "You try to slide the card into the slot, but it doesn't fit. Perhaps it's the wrong card?"
release_ending = "The Wheel of Fortune's beast spins, and with it the whole world spins. Beggars wake as kings and kings wake in the gutter, and fortunes are lost at dawn and won again by dusk. Nobody in Teranilus can count on anything, which means everyone is suddenly willing to gamble on everything. You hope the wheel lands in your favour. It was your hand that set it turning."
